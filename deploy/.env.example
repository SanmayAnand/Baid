# Copy to deploy/.env to override the development defaults. deploy/.env is not committed.
# These values are for the local stack only; never reuse them anywhere real.

NEO4J_PASSWORD=baid-dev-password
GRAFANA_ADMIN_PASSWORD=baid-dev-password

# The S3 credentials (baid / baid-dev-password) live in deploy/seaweedfs/s3.json.

# Image tags, if you need different ones.
# SEAWEEDFS_TAG=3.97
# PROMETHEUS_TAG=v3.5.0
